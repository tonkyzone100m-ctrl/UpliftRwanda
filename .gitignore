*.bak_*
*.dump
*.sqlite
*.db-journal
!db/database_snapshot.sql

# ---- Node / Vite ----
node_modules/
dist/
dist-ssr/
*.local

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---- Editor / OS ----
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ---- Secrets / environment ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- Scratch / backup artifacts (never commit; use db/database_snapshot.sql) ----
*.bak
*.bak_*
*.dump
*.sqlite
*.db-journal
db/database_backup.sql
!db/database_snapshot.sql

# ---- RDHS 2025 raw microdata (DHS redistribution rules; panel artifacts stay) ----
# The district panel (rdhs_2025_district_panel.json/.csv) IS committed. Recreate
# the raw recodes after NISR/DHS registration, then: python3 preprocess_rdhs.py
db/rdhs/*.dta


# ---- Node / Vite ----
node_modules/
dist/
dist-ssr/
*.local

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---- Editor / OS ----
.idea/
.vscode/*

# ---- Secrets / environment ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- Scratch / backup artifacts (never commit; use db/database_snapshot.sql) ----

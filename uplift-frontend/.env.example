# UpliftRwanda frontend — environment template.
# ONLY variables prefixed with VITE_ are exposed to the client bundle by Vite.
# Never put server secrets here; everything in the bundle is public.

# Base URL of the FastAPI backend (no trailing slash; trailing slashes are
# trimmed by api.js anyway).
#
# Local development: set to http://localhost:8000 if you self-host the API.
# Production (Vercel): Project Settings -> Environment Variables ->
#   VITE_API_BASE_URL=https://<your-public-api-host>
# When unset, api.js falls back to https://uplift-backend-77a1.onrender.com.
VITE_API_BASE_URL=http://localhost:8000

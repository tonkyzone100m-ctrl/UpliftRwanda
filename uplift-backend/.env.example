# UpliftRwanda backend — copy to `.env` (backend dir) and fill in.
# NEVER commit the filled-in copy; only this template is tracked.

# --- Database (PEER/TRUST local installs can leave DB_PASSWORD blank) ---
DB_NAME=uplift_rwanda_db
DB_USER=it-eng
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Or a full SQLAlchemy URL that overrides all DB_* vars:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/uplift_rwanda_db

# --- Admin authentication (rotate the defaults before any real deployment) ---
UPLIFT_ADMIN_PASSWORD=change-me-to-a-long-random-string
# Alternative: pre-hashed (bcrypt) password instead of plaintext:
# UPLIFT_ADMIN_PASSWORD_HASH=$2b$12$...

# --- Sessions ---
# Persistent random 64-hex secret; reuse across restarts so JWT sessions survive.
UPLIFT_JWT_SECRET=generate-with-openssl-rand-hex-32
# Sets the session lifetime in minutes (default 120)
UPLIFT_TOKEN_TTL_MINUTES=120

# --- CORS (comma-separated allowed browser origins) ---
# The code fallback already includes https://uplift-frontend.vercel.app, all
# Vercel preview aliases (regex https://*.vercel.app) and local dev ports
# (5173/4173/3000). Override here to tighten or extend, e.g. custom domains:
UPLIFT_CORS_ORIGINS=https://uplift-frontend.vercel.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000,http://127.0.0.1:3000

import logging
import os

from fastapi import Depends, FastAPI, Request
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse
from sqlalchemy import URL, create_engine, text
from sqlalchemy.exc import DBAPIError, SQLAlchemyError
from sqlalchemy.orm import Session, sessionmaker

logger = logging.getLogger("uplift_api")

# ---------------------------------------------------------------------------
# 1. Connection configuration
# ---------------------------------------------------------------------------
# Priority order:
#   a) DATABASE_URL            full SQLAlchemy URL (wins if exported)
#   b) DB_USER / DB_PASSWORD / DB_HOST / DB_PORT / DB_NAME   component vars
#   c) local development defaults
#
# Kali examples:
#   export DB_USER="postgres"
#   export DB_PASSWORD="your_password"          # any special chars ?/:/@ are
#   export DATABASE_URL="postgresql+psycopg2://postgres:your_password@localhost:5432/uplift_rwanda_db"
#   DB_HOST may be a unix socket dir e.g. /var/run/postgresql (peer auth, no password)

DB_NAME = os.getenv("DB_NAME", "uplift_rwanda_db")
DB_USER = os.getenv("DB_USER", "postgres")
DB_PASSWORD = os.getenv("uplift")            # None -> not supplied
DB_HOST = os.getenv("DB_HOST", "localhost")
DB_PORT = os.getenv("DB_PORT", "5432")


def build_database_url():
    explicit = os.getenv("DATABASE_URL")
    if explicit:
        return explicit
    # URL.create percent-encodes the password, so secrets like p@ss:w0rd? are safe
    return URL.create(
        "postgresql+psycopg2",
        username=DB_USER,
        password=DB_PASSWORD or None,
        host=DB_HOST,
        port=int(DB_PORT),
        database=DB_NAME,
    )


DATABASE_URL = build_database_url()

engine = create_engine(
    DATABASE_URL,
    pool_pre_ping=True,      # self-heals when Postgres drops/restarts connections
    pool_recycle=1800,       # retire connections older than 30 min
    connect_args={
        "connect_timeout": 5,          # fail fast if Postgres is not listening
        "application_name": "uplift_api",
    },
)
SessionLocal = sessionmaker(autocommit=False, autoflush=False, bind=engine)

app = FastAPI(title="UpliftRwanda API", version="1.2")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# ---------------------------------------------------------------------------
# 2. Robust session handling + clean JSON error mapping (no raw 500s)
# ---------------------------------------------------------------------------

def get_db():
    """Request-scoped session; connections are always returned to the pool."""
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()


def _db_hint(exc: DBAPIError) -> str:
    message = str(getattr(exc, "orig", exc)).lower()
    if "no password supplied" in message or "password authentication failed" in message:
        return (
            "PostgreSQL rejected the credentials. Fix with one of: "
            "(1) sudo -u postgres psql -c \"ALTER USER postgres PASSWORD 'your_password';\" "
            "then export DB_PASSWORD='your_password' and restart uvicorn; "
            "(2) export DATABASE_URL='postgresql+psycopg2://user:pass@localhost:5432/uplift_rwanda_db'; "
            "(3) passwordless peer auth: sudo -u postgres createuser -s "
            f"'{os.getenv('USER', 'postgres')}' and set DB_HOST=/var/run/postgresql."
        )
    if "could not connect" in message or "connection refused" in message:
        return "PostgreSQL is not reachable. Start it with: sudo systemctl start postgresql."
    if "does not exist" in message:
        return "Check that DB_NAME is correct and the database is seeded."
    return "Check DATABASE_URL / DB_* environment variables and pg_hba.conf."


@app.exception_handler(DBAPIError)
async def database_error_handler(request: Request, exc: DBAPIError):
    # Full detail only in server logs; the client gets a clean, stable payload.
    orig = getattr(exc, "orig", exc)
    logger.error("Database error on %s %s: %s", request.method, request.url.path, orig)
    return JSONResponse(
        status_code=503,
        content={
            "status": "error",
            "code": "database_unavailable",
            "detail": "The analytics database is unreachable or misconfigured.",
            "hint": _db_hint(exc),
            "path": request.url.path,
        },
    )


@app.exception_handler(SQLAlchemyError)
async def database_generic_handler(request: Request, exc: SQLAlchemyError):
    logger.error("SQLAlchemy error on %s %s: %s", request.method, request.url.path, exc)
    return JSONResponse(
        status_code=500,
        content={
            "status": "error",
            "code": "database_query_failed",
            "detail": "A database query failed while processing the request.",
            "path": request.url.path,
        },
    )

# ---------------------------------------------------------------------------
# 3. Endpoints
# ---------------------------------------------------------------------------

@app.get("/")
def read_root():
    return {"message": "Welcome to the UpliftRwanda NISR Analytics API"}


@app.get("/api/health")
def health():
    """Liveness probe: reports whether the database is reachable."""
    try:
        with engine.connect() as conn:
            conn.execute(text("SELECT 1"))
        return {"status": "ok", "database": "connected", "engine": engine.url.drivername}
    except DBAPIError as exc:
        logger.warning("Health check failed: %s", getattr(exc, "orig", exc))
        return JSONResponse(
            status_code=503,
            content={
                "status": "degraded",
                "database": "unreachable",
                "hint": _db_hint(exc),
            },
        )


def _as_int(value):
    """Coerce survey_year safely (Decimal/str/int -> int or None)."""
    if value is None:
        return None
    try:
        return int(value)
    except (TypeError, ValueError):
        return None


def _as_float(value):
    """Coerce metric values safely (Decimal/str/number -> float or None)."""
    if value is None:
        return None
    try:
        return float(value)
    except (TypeError, ValueError):
        return None


@app.get("/api/metrics")
def get_survey_metrics(db: Session = Depends(get_db)):
    query = text("""
        SELECT r.province, r.district, r.area_type,
               i.indicator_code, i.indicator_name, i.category, i.unit,
               sm.survey_year, sm.value
        FROM survey_metrics sm
        JOIN regions r ON sm.region_id = r.id
        JOIN indicators i ON sm.indicator_id = i.id
        ORDER BY r.province, r.district, i.indicator_code;
    """)
    rows = db.execute(query).fetchall()

    metrics = [{
        "province": row[0],
        "district": row[1],
        "area_type": row[2],
        "indicator_code": row[3],
        "indicator_name": row[4],
        "category": row[5],
        "unit": row[6],
        "survey_year": _as_int(row[7]),
        "value": _as_float(row[8]),
    } for row in rows]

    return {"status": "success", "count": len(metrics), "data": metrics}
